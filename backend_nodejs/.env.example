# Copy file nay thanh .env va dien gia tri phu hop
PORT=3000
# production bat buoc HTTPS; development cho phep HTTP de debug USB.
NODE_ENV=development
REQUIRE_HTTPS=false
# Origin chinh xac, cach nhau bang dau phay, khong co / cuoi. Rong = chan browser cross-origin.
CORS_ORIGINS=
# Chi IP/CIDR cua reverse proxy do ban quan ly. Rong = khong tin forwarded headers.
TRUSTED_PROXIES=
DB_HOST=127.0.0.1
DB_PORT=4000
DB_USER=root
DB_PASSWORD=
DB_NAME=mini_supermarket
# Bat buoc: tao chuoi ngau nhien toi thieu 32 ky tu, khong dung gia tri mac dinh.
JWT_SECRET=
JWT_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_IN=15m
BCRYPT_ROUNDS=10

# Gmail SMTP / app password. Neu de trong, OTP se duoc in ra console de demo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# OTP demo fallback: true thi in OTP ra console neu thieu Gmail/Twilio.
# Dat false khi muon bat buoc gui Gmail/SMS that.
ALLOW_OTP_CONSOLE_FALLBACK=false

# Twilio SMS OTP. TWILIO_FROM_NUMBER phai la so Twilio da cap, vi du +1...
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# VNPay sandbox (lay tai https://sandbox.vnpayment.vn/)
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# URL public (ngrok/cloudflared) tro ve backend local
VNP_RETURN_URL=https://YOUR_PUBLIC_HOST/api/payments/vnpay-return
VNP_IPN_URL=https://YOUR_PUBLIC_HOST/api/payments/vnpay-ipn

# Bank transfer webhook (Casso/SePay/generic)
BANK_WEBHOOK_SECRET=
BANK_TRANSFER_ACCOUNT_NUMBER=0363489746
